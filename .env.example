# Telegram Bot Configuration
BOT_TOKEN=

# Environment & Logging
NODE_ENV=development
LOG_LEVEL=info

# Database driver: 'jvault' (remote JsonVault) atau 'file' (lokal db.json)
DB_DRIVER=jvault
DB_PATH=./db.json
BACKUP_ENABLED=true
BACKUP_PATH=./backups

# JsonVault remote database (https://jvault.aerialstudio.tech)
# Jangan commit API key asli ke git — isi di .env lokal / environment server.
JVAULT_BASE_URL=https://jvault.aerialstudio.tech/
JVAULT_API_KEY=
JVAULT_BIN_ID=
JVAULT_TIMEOUT_MS=15000
